{
  "info": {
    "name": "Fuel Route API (Spotter assessment)",
    "description": "Route + cost-optimal fuel stops for a 500-mile-range, 10-mpg truck.\n\nStart the server (`python manage.py runserver`) and run the requests. Open the **Visualize** tab of a response to see the map. The first call for a route makes 1 routing API call; repeats are served from cache (`meta.route_cache_hit`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan a route",
      "item": [
        {
          "name": "New York → Los Angeles (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Postman \"Visualize\" tab: draws the route + fuel stops on a Leaflet map.",
                  "const body = pm.response.json();",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has a plan\", () => {",
                  "  pm.expect(body).to.have.property(\"fuel_stops\");",
                  "  pm.expect(body.summary).to.have.property(\"total_fuel_cost\");",
                  "});",
                  "console.log(\"total_fuel_cost\", body.summary.total_fuel_cost, \"timing_ms\", JSON.stringify(body.meta.timing_ms),",
                  "            \"external_api_calls\", JSON.stringify(body.meta.external_api_calls));",
                  "",
                  "const template = `",
                  "<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"/>",
                  "<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>",
                  "<div style=\"font-family:sans-serif;margin-bottom:6px\">",
                  "  <b>{{start.label}} &rarr; {{finish.label}}</b> &middot; {{route.distance_miles}} mi &middot;",
                  "  <b>Fuel: \\${{summary.total_fuel_cost}}</b> ({{summary.total_gallons_purchased}} gal, {{summary.number_of_stops}} stops)",
                  "  &middot; server {{meta.timing_ms.total}} ms &middot; cache hit: {{meta.route_cache_hit}}",
                  "</div>",
                  "<div id=\"map\" style=\"height:560px\"></div>",
                  "<script>",
                  "pm.getData(function (err, data) {",
                  "  var map = L.map(\"map\");",
                  "  L.tileLayer(\"https://tile.openstreetmap.org/{z}/{x}/{y}.png\",",
                  "              { attribution: \"&copy; OpenStreetMap contributors\" }).addTo(map);",
                  "  var layer = L.geoJSON(data.geojson, {",
                  "    style: { color: \"#1f6feb\", weight: 5 },",
                  "    onEachFeature: function (f, l) {",
                  "      var p = f.properties;",
                  "      if (p.kind === \"fuel_stop\") {",
                  "        l.bindTooltip(p.stop_number + \". \" + p.name + \" (\" + p.city + \", \" + p.state + \") $\" +",
                  "                      p.price_per_gallon + \"/gal, \" + p.gallons_purchased + \" gal = $\" + p.cost);",
                  "      } else if (p.label) {",
                  "        l.bindTooltip(p.kind + \": \" + p.label);",
                  "      }",
                  "    }",
                  "  }).addTo(map);",
                  "  map.fitBounds(layer.getBounds());",
                  "});",
                  "</script>`;",
                  "pm.visualizer.set(template, body);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "New York, NY"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "Coast to coast: ~2,800 mi, several fuel stops. Send twice to see the cached (warm) timing."
          }
        },
